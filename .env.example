# ============================================================
# 工单系统环境变量配置示例
# ============================================================
# 复制此文件为 .env，然后根据实际情况修改配置值
# ============================================================


# ============================================================
# API Key 认证配置（必填）
# ============================================================
# 格式: <api-key>:<user-id>:<role>,<api-key>:<user-id>:<role>,...
# 
# 说明:
#   - 多个 API Key 用逗号分隔
#   - 每个 Key 包含三部分，用冒号分隔
#   - role 可选值: user (普通用户), admin (管理员)
#
# 示例:
#   - sk_user_abc123:zhangsan:user      普通用户 zhangsan
#   - sk_admin_xyz789:admin001:admin    管理员 admin001
#
# 权限说明:
#   - 普通用户: 只能修改自己创建的工单的 SLA 截止时间
#   - 管理员: 可以修改任何工单的 SLA 截止时间
#
# ============================================================
API_KEYS=sk_user_001:user-001:user,sk_user_002:user-002:user,sk_admin_001:admin-001:admin


# ============================================================
# SLA 预警阈值配置（可选）
# ============================================================
# 单位: 小时
# 默认值: 24
#
# 说明:
#   当当前时间距离 SLA 截止时间小于此值时，
#   工单的 SLA 状态将显示为 "warning" (预警)
#
# 示例:
#   SLA_WARNING_THRESHOLD_HOURS=12   截止前 12 小时进入预警状态
#   SLA_WARNING_THRESHOLD_HOURS=48   截止前 48 小时进入预警状态
# ============================================================
SLA_WARNING_THRESHOLD_HOURS=24


# ============================================================
# SLA 过去时间允许配置（可选）
# ============================================================
# 默认值: false
#
# 说明:
#   是否允许设置过去的时间作为 SLA 截止时间
#   - false: 禁止设置过去时间（推荐，返回 422 错误）
#   - true:  允许设置过去时间（仅用于特殊场景）
# ============================================================
SLA_ALLOW_PAST_DEADLINE=false
